{
  "expo": {
    "name": "Midnight Munch",
    "slug": "midnight-munch",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "midnightmunch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slydum.midnightmunch"
    },
    "android": {
      "package": "com.slydum.midnightmunch",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}